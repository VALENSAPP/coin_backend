  MEDIA
  CHAT
  POST_SHARE
  STORY_COMMENT
}

enum MediaType {
  REEL
  STORY
  POST
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  DECLINED
}

enum UserSubscriptionStatus {
  ACTIVE
  CLOSED
}

enum FansSubscriptionStatus {
