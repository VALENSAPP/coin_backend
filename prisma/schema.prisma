generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id @default(uuid())
  firebaseUserId        String?                   @unique
  email                 String?                   @unique
  password              String?
  googleId              String?                   @unique
  twitterId             String?                   @unique
  appleId               String?                   @unique
  // Valens stores only user <-> public wallet mapping (non-custodial). No private keys.
  walletAddress         String?                   @unique
  registrationType      RegistrationType
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  age                   Int?
  deletedAt             DateTime?
  gender                Gender?
  image                 String?
  otp                   String?
  otpExpiresAt          DateTime?
  phoneNumber           String?
  isDeleted             Int                       @default(0)
  verifyEmail           Int                       @default(0)
  bio                   String?
  displayName           String?                   @unique
  userName              String?
  profile               String?                   @default("user") @db.VarChar(255)
  // DEPRECATED per Valens requirements: Valens does not create wallets or control private keys.
  walletMnemonic        String?
  walletPrivateKey      String?
  currentPeriodEnd      DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionEnd       DateTime?
  subscriptionStart     DateTime?
  subscriptionStatus    SubscriptionStatus        @default(INACTIVE)
  // DEPRECATED per Valens requirements: No internal balances or credits; revenue from software/Stripe only.
  tokenBalance          Float                     @default(0)
  kyc                   Boolean                   @default(false)
  first_log             Boolean                   @default(true)
  stripeAccountId       String?
  stripeBankAccountId   String?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  profileStatus         String                    @default("public")
  fansPage              Int                       @default(0)
  twoFact               Int                       @default(0)
  twoFactorSecret       String?
  website_link          String?
  social_media_links    Json?
  fcmToken              String?
  canAccessPlatform     String                    @default("false")
  referCode             String?
  referPoints           Float                     @default(1000)
  totalPlatformPoints   Float                     @default(1000)
  blockedBy             BlockedUser[]             @relation("Blocked")
  blockedUsers          BlockedUser[]             @relation("Blocker")
  followings            FollowerAndFollowing[]    @relation("Follower")
  followers             FollowerAndFollowing[]    @relation("Following")
  hidePosts             HidePost[]
  payments              Payment[]                 @relation("PaymentPayer")
  receivedPayments      Payment[]                 @relation("PaymentReceiver")
  tokenPurchases        TokenPurchase[]
  tokenSales            TokenSale[]
  donationData          DonationData[]
  posts                 Post[]
  privateCircles        PrivateCircle[]
  privateCircleMembers  PrivateCircleMember[]
  postReports           PostReport[]
  postComments          PostComment[]
  postCommentReactions  PostCommentReaction[]
  postLikes             PostLike[]
  receivedPosts         PostShare[]               @relation("ReceivedBy")
  sharedPosts           PostShare[]               @relation("SharedBy")
  savedPosts            SavePost[]
  pinnedPosts           PinnedPost[]
  stories               Story[]
  storyHighlights       StoryHighlight[]
  StoryComment          StoryComment[]
  storyLike             StoryLike[]
  storyViewsAsViewer    StoryView[]               @relation("StoryViewViewer")
  storyViewsAsOwner     StoryView[]               @relation("StoryViewOwner")
  sentConversations     Conversation[]            @relation("ConversationSender")
  receivedConversations Conversation[]            @relation("ConversationReceiver")
  userTokens            UserToken[]
  postHits              PostHit[]
  withdrawalRecords     WithdrawalRecord[]
  kycs                  Kyc[]
  userSubscriptions     UserSubscription[]
  fansSubscriptions     FansSubscriptionBuyData[] @relation("Fan")
  boughtSubscriptions   FansSubscriptionBuyData[] @relation("Buy")

  loginHistories              LoginHistory[]
  sessions                    UserSession[]
  sentChats                   ChatBox[]             @relation("ChatSender")
  receivedChats               ChatBox[]             @relation("ChatReceiver")
  notifications               Notification[]
  companyProfile              CompanyProfile?
  sentDigitalTransactions     digital_transaction[] @relation("Sender")
  receivedDigitalTransactions digital_transaction[] @relation("Receiver")
  referredUsers               UserReferral[]        @relation("UserReferrer")
  referredBy                  UserReferral[]        @relation("UserReferred")
  battlesCreated              Battle[]              @relation("BattleCreator")
  battlesWon                  Battle[]              @relation("BattleWinner")
  battleInvitesSent           BattleInvite[]        @relation("BattleInviter")
  battleInvitesReceived       BattleInvite[]        @relation("BattleInvited")
  battleParticipants          BattleParticipant[]
  battlePredictions           BattlePrediction[]
  battleComments              BattleComment[]
  battleCommentLikes          BattleCommentLike[]
  battleVotes                 BattleVote[]
  battleRewards               BattleReward[]
  battleActivities            BattleActivity[]
  battleAchievements          BattleAchievement[]
  battleStats                 UserBattleStats?
  deviceAccounts              DeviceAccount[]
  trustVotes                  PostTrustVote[]
  mycloset                    Mycloset?
  closetItems                 ClosetItems[]
  carts                       Cart[]
  marketPlaceOrders           MarketPlaceOrder[]
  ordersAsBuyer               Order[]                  @relation("OrderBuyer")
  ordersAsSeller              Order[]                  @relation("OrderSeller")
  userAddrees                 UserAddrees[]
}

model Mycloset {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String
  shopUsername    String          @unique
  shopLogo        String?
  description     String?         @db.Text
  shopCategory    String?
  location        String?
  whoCanBuy       WhoCanBuy       @default(Everyone)
  paymentMethod   String?
  shippingOptions ShippingOptions @default(ship_items)
  returnPolicy    String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  closetItems     ClosetItems[]
  orders          Order[]

  @@index([userId])
  @@index([shopUsername])
}

model ClosetItems {
  id                   String              @id @default(uuid())
  closetId             String
  userId               String
  images               String[]            @default([])
  name                 String
  category             String
  brand                String?
  condition            ClosetItemCondition
  description          String?             @db.Text
  price                Float
  quantity             Int                 @default(1)
  isActive             Boolean             @default(true)
  isDeleted            Boolean             @default(false)
  soldCount            Int                 @default(0)
  shippingOption       ShippingOptions
  estimateShippingTime String?
  returnPolicy         String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  closet               Mycloset            @relation(fields: [closetId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems            CartItems[]
  orderItems           MarketPlaceOrderItem[]
  orderSnapshots       OrderItem[]

  @@index([closetId])
  @@index([userId])
  @@index([category])
  @@map("closetItems")
}

model Cart {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cartItems CartItems[]

  @@index([userId])
  @@map("cart")
}

model CartItems {
  id        String     @id @default(uuid())
  cartId    String
  productId String
  quantity  Int        @default(1)
  price     Float
  subtotal  Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   ClosetItems @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@unique([cartId, productId])
  @@map("cartItems")
}

model UserAddrees {
  id              String   @id @default(uuid())
  userId          String
  fullName        String
  phoneNumber     String
  alternateNumber String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  country         String
  postalCode      String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([userId])
  @@index([isDefault])
}

model CompanyProfile {
  id                               String    @id @default(uuid())
  userId                           String    @unique
  user                             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName                     String?
  ownerName                        String?
  email                            String?
  phone                            String?
  category                         String?
  address                          String?
  description                      String?   @db.Text
  website                          String?
  gstNumber                        String?
  documentUrls                     String[]  @default([])
  sumSubApplicantId                String?
  documentVerificationStatus       String?
  documentVerificationAt           DateTime?
  documentVerificationRejectReason String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([userId])
}

model Post {
  id               String          @id @default(uuid())
  text             String?
  images           String[]
  thumbnails       String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           String
  deletedAt        DateTime?
  isDelete         isdelete        @default(no)
  caption          String?
  hashtag          String[]
  location         String?
  music            String?
  youtubeMusicMeta Json?
  taggedPeople     String[]
  raiseAmount      Float?
  start_time       DateTime?
  end_time         DateTime?
  type             String?
  link             String?
  visibleTo        String?
  privateCircleId  String?
  format           format          @default(image)
  postHide         postHide        @default(no)
  isTrustPost      Boolean         @default(false)
  videoText        Boolean         @default(false)
  videoTextItems   Json?
  ebookpdf         String?
  tableContent     String[]
  allowDownload    Boolean         @default(true)
  hides            HidePost[]
  reports          PostReport[]
  user             User            @relation(fields: [userId], references: [id])
  privateCircle    PrivateCircle?  @relation(fields: [privateCircleId], references: [id], onDelete: SetNull)
  comments         PostComment[]
  likes            PostLike[]
  shares           PostShare[]
  saves            SavePost[]
  pinnedBy         PinnedPost[]
  trustVotes       PostTrustVote[]

  @@index([privateCircleId])
}

model PrivateCircle {
  id        String                @id @default(uuid())
  ownerId   String
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean               @default(true)
  minSlots  Int
  maxSlots  Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  members   PrivateCircleMember[]
  posts     Post[]

  @@unique([ownerId])
  @@index([ownerId])
}

model PrivateCircleMember {
  id              String                    @id @default(uuid())
  privateCircleId String
  userId          String
  status          PrivateCircleMemberStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  privateCircle   PrivateCircle             @relation(fields: [privateCircleId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([privateCircleId, userId])
  @@index([userId])
  @@index([privateCircleId, status])
}

model PinnedPost {
  id       String   @id @default(uuid())
  postId   String
  userId   String
  pinnedAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, pinnedAt])
  @@index([postId])
}

model PostLike {
  id            String   @id @default(uuid())
  postId        String
  userId        String
  isReadByOwner Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id          String                @id @default(uuid())
  postId      String
  userId      String
  comment     String
  parentId    String?
  commentType cmntType              @default(NORMAL)
  createdAt   DateTime              @default(now())
  post        Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      PostComment?          @relation("PostCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[]         @relation("PostCommentThread")
  reactions   PostCommentReaction[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model PostCommentReaction {
  id        String       @id @default(uuid())
  commentId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  comment   PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model SavePost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
}

// Follow/Unfollow: platform records relationship. Follow Pass (NFT/soulbound) mint/burn is user wallet-signed on-chain.
model FollowerAndFollowing {
  id          String       @id @default(uuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  follower    User         @relation("Follower", fields: [followerId], references: [id])
  following   User         @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
}

model PostShare {
  id             String   @id @default(uuid())
  postId         String
  sharedUserId   String
  receiverUserId String
  createdAt      DateTime @default(now())
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  receivedBy     User     @relation("ReceivedBy", fields: [receiverUserId], references: [id], onDelete: Cascade)
  sharedBy       User     @relation("SharedBy", fields: [sharedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, sharedUserId, receiverUserId])
}

model HidePost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostReport {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Story {
  id             String               @id @default(uuid())
  userId         String
  media          String[]
  thumbnails     String[]             @default([])
  caption        String?
  type           String               @default("normal")
  storyMeta      Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  user           User                 @relation(fields: [userId], references: [id])
  comment        StoryComment[]
  storyLike      StoryLike[]
  views          StoryView[]
  highlightItems StoryHighlightItem[]

  @@index([userId])
}

model StoryHighlight {
  id         String               @id @default(uuid())
  userId     String
  title      String
  coverImage String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      StoryHighlightItem[]

  @@index([userId])
}

model StoryHighlightItem {
  id          String         @id @default(uuid())
  highlightId String
  storyId     String
  position    Int?
  createdAt   DateTime       @default(now())
  highlight   StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story       Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([highlightId, storyId])
  @@index([storyId])
}

model Payment {
  id                    String    @id @default(uuid())
  userId                String
  receiverId            String?
  amount                Int
  platformFee           Int?
  totalAmount           Int?
  currency              String
  status                String
  forPayment            String    @default("subscription") // "subscription" or "following"
  isReadByOwner         Boolean   @default(false)
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  createdAt             DateTime  @default(now())
  periodStart           DateTime?
  periodEnd             DateTime?
  user                  User      @relation("PaymentPayer", fields: [userId], references: [id], onDelete: Cascade)
  receiver              User?     @relation("PaymentReceiver", fields: [receiverId], references: [id])

  @@index([userId])
  @@index([receiverId])
}

model MarketPlacePayments {
  id              String   @id @default(uuid())
  userId          String?
  cartId          String?
  orderId         String?  @unique
  transactionId   String?
  paymentIntentId String?  @unique
  amount          Int
  currency        String
  provider        String
  status          String   @default("PENDING")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]

  @@index([userId])
  @@index([cartId])
  @@index([status])
  @@index([createdAt])
  @@map("marketPlacePayments")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  buyerId           String
  sellerId          String
  closetId          String
  addressId         String
  paymentId         String?
  subtotal          Float
  shippingCost      Float
  serviceFee        Float
  total             Float
  paymentMethod     String
  paymentStatus     PaymentStatus
  orderStatus       OrderStatus
  shippingCarrier   String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  buyer             User          @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller            User          @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  closet            Mycloset      @relation(fields: [closetId], references: [id], onDelete: Restrict)
  address           UserAddrees   @relation(fields: [addressId], references: [id], onDelete: Restrict)
  payment           MarketPlacePayments? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items             OrderItem[]

  @@index([buyerId, createdAt])
  @@index([sellerId, orderStatus])
  @@index([paymentId])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String
  quantity     Int
  price        Float
  subtotal     Float
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      ClosetItems @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model MarketPlaceOrder {
  id              String                 @id @default(uuid())
  userId          String
  paymentId       String                 @unique
  paymentIntentId String?                @unique
  totalAmount     Int
  currency        String
  status          String                 @default("PAID")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           MarketPlaceOrderItem[]

  @@index([userId])
  @@index([createdAt])
  @@map("marketPlaceOrder")
}

model MarketPlaceOrderItem {
  id         String          @id @default(uuid())
  orderId    String
  productId  String
  sellerId   String
  quantity   Int
  unitPrice  Int
  subtotal   Int
  createdAt  DateTime        @default(now())
  order      MarketPlaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    ClosetItems      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@map("marketPlaceOrderItem")
}

model TokenPurchase {
  id                      String    @id @default(uuid())
  userId                  String
  vendorId                String? // User whose token is being purchased
  amount                  Float // Original payment amount in USD
  currency                String    @default("USD")
  platformFee             Float // 0.2% platform fee
  vendorFee               Float // 0.5% vendor fee
  restAmount              Float // Amount after fees (93.3% of original)
  tokensReceived          Float // Tokens credited (restAmount * 100)
  status                  String    @default("pending") // pending, completed, failed
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  purchaseTokenPrice      Float?    @default(0) //Token Price at the time user purchase
  stripeInvoiceId         String?
  action                  String    @default("buy") // "buy" or "sell"
  createdAt               DateTime  @default(now())
  completedAt             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([status])
}

model TokenSale {
  id                   String   @id @default(uuid())
  userId               String // User selling the tokens
  tokenAddress         String // Token contract address
  vendorId             String // User whose token is being sold
  amountTokens         String // Amount of tokens sold (in wei)
  sellAmount           Float // Amount of tokens sold (converted to float for calculations)
  actualReceivedAmount Float?
  adminFeeAmount       Float?
  transactionHash      String // Blockchain transaction hash
  status               String   @default("completed") // completed, failed
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenAddress])
  @@index([vendorId])
  @@index([status])
}

model DonationData {
  id                      String    @id @default(uuid())
  userId                  String
  vendorId                String? // User receiving the donation
  postId                  String? // Post for which donation is made
  amount                  Float // Receiver amount in USD after platform fee
  totalAmount             Float? // Original donation amount in USD before platform fee
  platformFees            Float? // Platform fee amount in USD
  currency                String    @default("USD")
  status                  String    @default("pending") // pending, completed, failed
  isReadByOwner           Boolean   @default(false)
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  purchaseTokenPrice      Float?    @default(0)
  stripeInvoiceId         String?
  action                  String    @default("donate")
  createdAt               DateTime  @default(now())
  completedAt             DateTime?
  note                    String?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([postId])
  @@index([status])
}

model StoryComment {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  Story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([userId])
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  ownerId   String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation("StoryViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  owner     User     @relation("StoryViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([ownerId])
  @@index([createdAt])
}

model Conversation {
  id         String           @id @default(uuid())
  type       ConversationType
  senderId   String
  receiverId String
  content    String?
  mediaId    String?
  mediaType  MediaType?
  chatId     String?
  isSeen     Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("ConversationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ConversationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([mediaId])
  @@index([chatId])
}

model UserToken {
  id              String   @id @default(uuid())
  userId          String
  transactionHash String   @unique
  tokenAddress    String?  @unique
  tokenName       String
  tokenSymbol     String
  initialSupply   String
  initialPrice    String
  scalingConstant String
  blockNumber     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenAddress])
}

model PostHit {
  id          String    @id @default(uuid())
  userId      String
  hitLeft     Int // User's hit left to add the post 
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalRecord {
  id             String    @id @default(uuid())
  userId         String
  withdrawAmount Float?
  txhash         String?
  status         String    @default("pending") // pending, processing, processing_transfer, success, failed, requires_onboarding
  failureReason  String?
  processingAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Kyc {
  id                Int       @id @default(autoincrement())
  userId            String
  veriffSessionId   String
  veriffUrl         String
  sumsubApplicantId String?
  status            KycStatus @default(PENDING)
  documentType      String?
  webhookData       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id])
}

model UserSubscription {
  id                 String                 @id @default(uuid())
  userId             String
  subscriptionAmount Float
  status             UserSubscriptionStatus @default(ACTIVE)
  comment            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isDelete           Int                    @default(0)
  user               User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model FansSubscriptionBuyData {
  id        String                 @id @default(uuid())
  fanUserId String
  buyUserId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  status    FansSubscriptionStatus @default(ACTIVE)
  fanUser   User                   @relation("Fan", fields: [fanUserId], references: [id])
  buyUser   User                   @relation("Buy", fields: [buyUserId], references: [id])

  @@index([fanUserId])
  @@index([buyUserId])
  @@index([status])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  loginDate DateTime @default(now())
  location  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id                    String    @id @default(uuid())
  userId                String
  refreshTokenHash      String
  refreshTokenExpiresAt DateTime
  userAgent             String?
  ipAddress             String?
  location              String?
  deviceName            String?
  deviceType            String?
  deviceId              String?
  lastActiveAt          DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([refreshTokenExpiresAt])
}

model DeviceAccount {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String
  isPrimary   Boolean   @default(false)
  addedAt     DateTime  @default(now())
  lastLoginAt DateTime  @default(now())
  removedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
  @@index([deviceId])
  @@index([userId])
  @@index([removedAt])
}

model ChatBox {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  hiddenBy   String[] // Array of user IDs who have hidden this chat
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  // Note: For bidirectional uniqueness, we rely on application logic to prevent duplicates
  // since Prisma doesn't easily support complex unique constraints for bidirectional relationships

  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model digital_transaction {
  id         Int      @id @default(autoincrement())
  senderId   String
  receiverId String
  amount     Decimal  @db.Decimal(18, 8)
  txId       String   @unique
  txType     String
  txValue    Decimal  @db.Decimal(18, 8)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model UserReferral {
  id                 String   @id @default(uuid())
  referrerId         String
  referredUserId     String
  referrerPoints     Int?
  referredUserPoints Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  referrer     User @relation("UserReferrer", fields: [referrerId], references: [id])
  referredUser User @relation("UserReferred", fields: [referredUserId], references: [id])

  @@unique([referrerId, referredUserId])
}

model Battle {
  id               String       @id @default(uuid())
  creatorId        String
  format           BattleFormat
  status           BattleStatus @default(DRAFT)
  question         String
  options          String[]     @default([])
  optionImages     String[]     @default([])
  startTime        DateTime?
  endTime          DateTime
  resolutionMethod String?
  isPublic         Boolean      @default(true)
  stakeAmount      Float?
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  liveAt           DateTime?
  closedAt         DateTime?
  resolvedAt       DateTime?
  winningSide      String?
  correctSide      String?
  winnerUserId     String?

  creator      User                @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  winner       User?               @relation("BattleWinner", fields: [winnerUserId], references: [id])
  invites      BattleInvite[]
  participants BattleParticipant[]
  predictions  BattlePrediction[]
  comments     BattleComment[]
  votes        BattleVote[]
  rewards      BattleReward[]
  activities   BattleActivity[]
  achievements BattleAchievement[]

  @@index([creatorId])
  @@index([status])
  @@index([format])
}

model BattleInvite {
  id            String             @id @default(uuid())
  battleId      String
  inviterId     String
  invitedUserId String
  status        BattleInviteStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  respondedAt   DateTime?

  battle  Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  inviter User   @relation("BattleInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invited User   @relation("BattleInvited", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([battleId, invitedUserId])
  @@index([inviterId])
  @@index([invitedUserId])
}

model BattleParticipant {
  id                String    @id @default(uuid())
  battleId          String
  userId            String
  side              String?
  openingArgument   String?   @db.Text
  joinedAt          DateTime  @default(now())
  score             Int       @default(0)
  stakeWon          Float     @default(0)
  baseJoinPoints    Int       @default(0)
  argumentPoints    Int       @default(0)
  engagementPoints  Int       @default(0)
  timingBonus       Int       @default(0)
  underdogBonus     Int       @default(0)
  winnerBonus       Int       @default(0)
  loserPenalty      Int       @default(0)
  argumentSubmitted Boolean   @default(false)
  likesCount        Int       @default(0)
  votePoints        Int       @default(0)
  isWinner          Boolean   @default(false)
  awardedAt         DateTime?

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model UserBattleStats {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  totalBattlePoints       Int      @default(0)
  totalStakeWon           Float    @default(0)
  totalBattlesJoined      Int      @default(0)
  totalBattlesWon         Int      @default(0)
  totalPredictionsCorrect Int      @default(0)
  totalPredictionsWrong   Int      @default(0)
  totalArgumentsSubmitted Int      @default(0)
  totalArgumentLikes      Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BattlePrediction {
  id            String   @id @default(uuid())
  battleId      String
  userId        String
  side          String
  justification String
  sourceUrl     String?
  createdAt     DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model BattleComment {
  id        String    @id @default(uuid())
  battleId  String
  userId    String
  comment   String
  images    String[]  @default([])
  highlight Json?
  isPin     Boolean   @default(false)
  pinnedAt  DateTime?
  parentId  String?
  createdAt DateTime  @default(now())

  battle  Battle              @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  BattleComment?      @relation("BattleCommentThread", fields: [parentId], references: [id])
  replies BattleComment[]     @relation("BattleCommentThread")
  likes   BattleCommentLike[]

  @@index([battleId])
  @@index([userId])
}

model BattleCommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment BattleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model BattleVote {
  id        String   @id @default(uuid())
  battleId  String
  userId    String
  side      String
  createdAt DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model BattleReward {
  id           String   @id @default(uuid())
  battleId     String
  userId       String
  rank         Int?
  rewardPoints Float?
  rewardType   String?  @default("CRED")
  createdAt    DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([userId])
}

model BattleAchievement {
  id          String   @id @default(uuid())
  userId      String
  battleId    String?
  code        String
  title       String
  description String?
  unlockedAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  battle Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([battleId])
  @@index([code])
}

model BattleActivity {
  id        String   @id @default(uuid())
  userId    String
  battleId  String?
  type      String
  data      Json?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  battle Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([battleId])
  @@index([type])
}

model PostTrustVote {
  id String @id @default(uuid())

  userId String
  postId String

  voteType TrustVoteType

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([postId])
}

model DeletedUser {
  id        String   @id @default(uuid())
  userId    String
  profile   String?
  email     String?
  deletedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deleted_users")
}

